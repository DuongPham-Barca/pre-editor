    "paragraphs":  [
                       {
                           "index":  1,
                           "style_id":  "Heading1",
                           "style":  "heading 1",
                           "numbered":  false,
                           "numbering_id":  "",
                           "numbering_level":  "",
                           "text":  "Product Requirement Document (PRD)"
                       },
                       {
                           "index":  2,
                           "style_id":  "Heading2",
                           "style":  "heading 2",
                           "numbered":  false,
                           "numbering_id":  "",
                           "numbering_level":  "",
                           "text":  "Project: \"Audio-First\" Podcast Pre-Editor Engine \n(Phase 1 \u0026 2)"
                       },
                       {
                           "index":  4,
                           "style_id":  "Heading3",
                           "style":  "heading 3",
                           "numbered":  false,
                           "numbering_id":  "",
                           "numbering_level":  "",
                           "text":  "Document Information"
                       },
                       {
                           "index":  5,
                           "style_id":  "",
                           "style":  "",
                           "numbered":  true,
                           "numbering_id":  "4",
                           "numbering_level":  "0",
                           "text":  "Document Version: 1.0"
                       },
                       {
                           "index":  6,
                           "style_id":  "",
                           "style":  "",
                           "numbered":  true,
                           "numbering_id":  "4",
                           "numbering_level":  "0",
                           "text":  "Date: June 2026"
                       },
                       {
                           "index":  7,
                           "style_id":  "",
                           "style":  "",
                           "numbered":  true,
                           "numbering_id":  "4",
                           "numbering_level":  "0",
                           "text":  "Author: Nguyễn Ngọc Dương (Django), Founder \u0026 CEO"
                       },
                       {
                           "index":  8,
                           "style_id":  "",
                           "style":  "",
                           "numbered":  true,
                           "numbering_id":  "4",
                           "numbering_level":  "0",
                           "text":  "Target Architecture: Local Processing Worker / CLI + Cloud AI Integration"
                       },
                       {
                           "index":  10,
                           "style_id":  "Heading2",
                           "style":  "heading 2",
                           "numbered":  false,
                           "numbering_id":  "",
                           "numbering_level":  "",
                           "text":  "1. Product Overview \u0026 Goals"
                       },
                       {
                           "index":  11,
                           "style_id":  "",
                           "style":  "",
                           "numbered":  true,
                           "numbering_id":  "7",
                           "numbering_level":  "0",
                           "text":  "The objective of the Pre-Editor Engine is to eliminate the manual 2-day \"rough cut\" bottleneck in multi-camera video podcast production."
                       },
                       {
                           "index":  12,
                           "style_id":  "",
                           "style":  "",
                           "numbered":  true,
                           "numbering_id":  "7",
                           "numbering_level":  "0",
                           "text":  "The system treats multi-cam video editing as a pure data metadata problem. Instead of processing heavy 4K video files, it extracts isolated audio tracks locally, leverages semantic AI models to filter the narrative based on a text brief, and uses deterministic audio amplitude analytics to track the active speaker."
                       },
                       {
                           "index":  13,
                           "style_id":  "",
                           "style":  "",
                           "numbered":  true,
                           "numbering_id":  "7",
                           "numbering_level":  "0",
                           "text":  "The final output is a lightweight, frame-accurate FCPXML sequence importable directly into Adobe Premiere Pro with 0.5-second safety handles pre-applied."
                       },
                       {
                           "index":  15,
                           "style_id":  "Heading2",
                           "style":  "heading 2",
                           "numbered":  false,
                           "numbering_id":  "",
                           "numbering_level":  "",
                           "text":  "2. Technical Stack \u0026 Architecture Baseline"
                       },
                       {
                           "index":  16,
                           "style_id":  "",
                           "style":  "",
                           "numbered":  true,
                           "numbering_id":  "6",
                           "numbering_level":  "0",
                           "text":  "Local Processing Script: Python 3.11+"
                       },
                       {
                           "index":  17,
                           "style_id":  "",
                           "style":  "",
                           "numbered":  true,
                           "numbering_id":  "6",
                           "numbering_level":  "0",
                           "text":  "Audio Engineering Libraries: pydub, scipy.io.wavfile, numpy"
                       },
                       {
                           "index":  18,
                           "style_id":  "",
                           "style":  "",
                           "numbered":  true,
                           "numbering_id":  "6",
                           "numbering_level":  "0",
                           "text":  "Transcription API: GPT-4o transcription, ElevenLabs Scribe v2, Deepgram Nova-3"
                       },
                       {
                           "index":  19,
                           "style_id":  "",
                           "style":  "",
                           "numbered":  true,
                           "numbering_id":  "6",
                           "numbering_level":  "1",
                           "text":  "ElevenLabs Scribe v2: Use if Sunrise’s podcast client needs premium features like native laughter/applause tracking to automate creative camera switches."
                       },
                       {
                           "index":  20,
                           "style_id":  "",
                           "style":  "",
                           "numbered":  true,
                           "numbering_id":  "6",
                           "numbering_level":  "1",
                           "text":  "Deepgram Nova-3: Use if the main goal is raw, ultra-fast speaker timestamps at the lowest possible metered API cost."
                       },
                       {
                           "index":  21,
                           "style_id":  "",
                           "style":  "",
                           "numbered":  true,
                           "numbering_id":  "6",
                           "numbering_level":  "1",
                           "text":  "Alternative solution"
                       },
                       {
                           "index":  22,
                           "style_id":  "",
                           "style":  "",
                           "numbered":  true,
                           "numbering_id":  "6",
                           "numbering_level":  "0",
                           "text":  "LLM Engine: Gemini 3.5 Flash or Claude 3.5 Haiku (Zero-Data Retention enforced)"
                       },
                       {
                           "index":  23,
                           "style_id":  "",
                           "style":  "",
                           "numbered":  true,
                           "numbering_id":  "6",
                           "numbering_level":  "0",
                           "text":  "Metadata Exporter: xml.etree.ElementTree (Python native)"
                       },
                       {
                           "index":  24,
                           "style_id":  "",
                           "style":  "",
                           "numbered":  true,
                           "numbering_id":  "6",
                           "numbering_level":  "0",
                           "text":  "Target NLE Compatibility: Adobe Premiere Pro (v24.0+)"
                       },
                       {
                           "index":  26,
                           "style_id":  "Heading2",
                           "style":  "heading 2",
                           "numbered":  false,
                           "numbering_id":  "",
                           "numbering_level":  "",
                           "text":  "3. Detailed Functional Modules \u0026 Engineering Specs"
                       },
                       {
                           "index":  28,
                           "style_id":  "Heading3",
                           "style":  "heading 3",
                           "numbered":  false,
                           "numbering_id":  "",
                           "numbering_level":  "",
                           "text":  "Module 1: Local Media Ingestion \u0026 Extraction (Python Worker)"
                       },
                       {
                           "index":  29,
                           "style_id":  "",
                           "style":  "",
                           "numbered":  false,
                           "numbering_id":  "",
                           "numbering_level":  "",
                           "text":  "[Raw Video Files: Cam A, Cam B, Wide] ──\u003e FFMPEG ──\u003e [16kHz Mono WAV Audio Tracks]"
                       },
                       {
                           "index":  31,
                           "style_id":  "",
                           "style":  "",
                           "numbered":  true,
                           "numbering_id":  "1",
                           "numbering_level":  "0",
                           "text":  "Input Directory: The system must scan a local target folder containing 2-3 isolated camera video angles (.mp4, .mov) and individual microphone audio stems (.wav)."
                       },
                       {
                           "index":  32,
                           "style_id":  "",
                           "style":  "",
                           "numbered":  true,
                           "numbering_id":  "1",
                           "numbering_level":  "0",
                           "text":  "Audio Extraction: Execute an automated ffmpeg background process to extract and isolate audio tracks."
                       },
                       {
                           "index":  33,
                           "style_id":  "",
                           "style":  "",
                           "numbered":  true,
                           "numbering_id":  "1",
                           "numbering_level":  "0",
                           "text":  "Specification: Convert audio to 16kHz, Mono, 16-bit WAV files to optimize processing speed."
                       },
                       {
                           "index":  34,
                           "style_id":  "",
                           "style":  "",
                           "numbered":  true,
                           "numbering_id":  "1",
                           "numbering_level":  "0",
                           "text":  "SMPTE Timecode Alignment: Capture and store the absolute starting timecode header from the raw files to ensure zero timecode drift during final sequence compilation."
                       },
                       {
                           "index":  35,
                           "style_id":  "Heading3",
                           "style":  "heading 3",
                           "numbered":  false,
                           "numbering_id":  "",
                           "numbering_level":  "",
                           "text":  "Module 2: Whisper Transcription Pipeline"
                       },
                       {
                           "index":  36,
                           "style_id":  "",
                           "style":  "",
                           "numbered":  true,
                           "numbering_id":  "9",
                           "numbering_level":  "0",
                           "text":  "Multi-Track Text Generation: Send the primary speaker audio files to the Whisper Speech-to-Text API."
                       },
                       {
                           "index":  37,
                           "style_id":  "",
                           "style":  "",
                           "numbered":  true,
                           "numbering_id":  "9",
                           "numbering_level":  "0",
                           "text":  "Word-Level Timestamping: Enforce the explicit extraction of word-level timestamps."
                       },
                       {
                           "index":  38,
                           "style_id":  "",
                           "style":  "",
                           "numbered":  true,
                           "numbering_id":  "9",
                           "numbering_level":  "0",
                           "text":  "Data Schema Requirement: The pipeline must output a JSON data layout structured as follows:"
                       },
                       {
                           "index":  40,
                           "style_id":  "",
                           "style":  "",
                           "numbered":  false,
                           "numbering_id":  "",
                           "numbering_level":  "",
                           "text":  "JSON"
                       },
                       {
                           "index":  41,
                           "style_id":  "",
                           "style":  "",
                           "numbered":  false,
                           "numbering_id":  "",
                           "numbering_level":  "",
                           "text":  "{"
                       },
                       {
                           "index":  42,
                           "style_id":  "",
                           "style":  "",
                           "numbered":  false,
                           "numbering_id":  "",
                           "numbering_level":  "",
                           "text":  "\"word\": \"Welcome\","
                       },
                       {
                           "index":  43,
                           "style_id":  "",
                           "style":  "",
                           "numbered":  false,
                           "numbering_id":  "",
                           "numbering_level":  "",
                           "text":  "\"start_ms\": 12500,"
                       },
                       {
                           "index":  44,
                           "style_id":  "",
                           "style":  "",
                           "numbered":  false,
                           "numbering_id":  "",
                           "numbering_level":  "",
                           "text":  "\"end_ms\": 12900,"
                       },
                       {
                           "index":  45,
                           "style_id":  "",
                           "style":  "",
                           "numbered":  false,
                           "numbering_id":  "",
                           "numbering_level":  "",
                           "text":  "\"speaker_id\": \"Mic_1\""
                       },
                       {
                           "index":  46,
                           "style_id":  "",
                           "style":  "",
                           "numbered":  false,
                           "numbering_id":  "",
                           "numbering_level":  "",
                           "text":  "}"
                       },
                       {
                           "index":  48,
                           "style_id":  "Heading3",
                           "style":  "heading 3",
                           "numbered":  false,
                           "numbering_id":  "",
                           "numbering_level":  "",
                           "text":  "Module 3: Semantic RAG Narrative Filter Engine"
                       },
                       {
                           "index":  49,
                           "style_id":  "",
                           "style":  "",
                           "numbered":  true,
                           "numbering_id":  "5",
                           "numbering_level":  "0",
                           "text":  "Context Vector Input: Ingest the raw string payload of the \"Podcast Plan\" (Creative Brief)."
                       },
                       {
                           "index":  50,
                           "style_id":  "",
                           "style":  "",
                           "numbered":  true,
                           "numbering_id":  "5",
                           "numbering_level":  "0",
                           "text":  "Semantic Filtering Prompt: Pass the complete, chronological transcription block alongside the Podcast Plan into the LLM."
                       },
                       {
                           "index":  51,
                           "style_id":  "",
                           "style":  "",
                           "numbered":  true,
                           "numbering_id":  "5",
                           "numbering_level":  "0",
                           "text":  "Model Constraint: Command the model to output only a JSON array containing highly precise timestamp blocks of conversational paths that match the target narrative arcs, filtering out tangents."
                       },
                       {
                           "index":  53,
                           "style_id":  "",
                           "style":  "",
                           "numbered":  false,
                           "numbering_id":  "",
                           "numbering_level":  "",
                           "text":  "JSON"
                       },
                       {
                           "index":  54,
                           "style_id":  "",
                           "style":  "",
                           "numbered":  false,
                           "numbering_id":  "",
                           "numbering_level":  "",
                           "text":  "{"
                       },
                       {
                           "index":  55,
                           "style_id":  "",
                           "style":  "",
                           "numbered":  false,
                           "numbering_id":  "",
                           "numbering_level":  "",
                           "text":  "\"keep_zones\": ["
                       },
                       {
                           "index":  56,
                           "style_id":  "",
                           "style":  "",
                           "numbered":  false,
                           "numbering_id":  "",
                           "numbering_level":  "",
                           "text":  "{\"start_ms\": 10000, \"end_ms\": 250000, \"topic\": \"Introduction\"},"
                       },
                       {
                           "index":  57,
                           "style_id":  "",
                           "style":  "",
                           "numbered":  false,
                           "numbering_id":  "",
                           "numbering_level":  "",
                           "text":  "{\"start_ms\": 310000, \"end_ms\": 890000, \"topic\": \"Core Discussion\"}"
                       },
                       {
                           "index":  58,
                           "style_id":  "",
                           "style":  "",
                           "numbered":  false,
                           "numbering_id":  "",
                           "numbering_level":  "",
                           "text":  "]"
                       },
                       {
                           "index":  59,
                           "style_id":  "",
                           "style":  "",
                           "numbered":  false,
                           "numbering_id":  "",
                           "numbering_level":  "",
                           "text":  "}"
                       },
                       {
                           "index":  61,
                           "style_id":  "Heading3",
                           "style":  "heading 3",
                           "numbered":  false,
                           "numbering_id":  "",
                           "numbering_level":  "",
                           "text":  "Module 4: Audio-Level Diarization \u0026 Switching Logic (Phase 1 Focus)"
                       },
                       {
                           "index":  62,
                           "style_id":  "",
                           "style":  "",
                           "numbered":  false,
                           "numbering_id":  "",
                           "numbering_level":  "",
                           "text":  "For every designated keep_zone, the Python engine must determine which camera angle to activate on a millisecond-by-millisecond layer."
                       },
                       {
                           "index":  63,
                           "style_id":  "",
                           "style":  "",
                           "numbered":  false,
                           "numbering_id":  "",
                           "numbering_level":  "",
                           "text":  "[Calculate RMS dBFS over 100ms Window]"
                       },
                       {
                           "index":  64,
                           "style_id":  "",
                           "style":  "",
                           "numbered":  false,
                           "numbering_id":  "",
                           "numbering_level":  "",
                           "text":  "│"
                       },
                       {
                           "index":  65,
                           "style_id":  "",
                           "style":  "",
                           "numbered":  false,
                           "numbering_id":  "",
                           "numbering_level":  "",
                           "text":  "┌─────────────────────┴─────────────────────┐"
                       },
                       {
                           "index":  66,
                           "style_id":  "",
                           "style":  "",
                           "numbered":  false,
                           "numbering_id":  "",
                           "numbering_level":  "",
                           "text":  "▼                                           ▼"
                       },
                       {
                           "index":  67,
                           "style_id":  "",
                           "style":  "",
                           "numbered":  false,
                           "numbering_id":  "",
                           "numbering_level":  "",
                           "text":  "[Track A \u003e Track B + 4dB?]              [Track A ≈ Track B Within 2dB]"
                       },
                       {
                           "index":  68,
                           "style_id":  "",
                           "style":  "",
                           "numbered":  false,
                           "numbering_id":  "",
                           "numbering_level":  "",
                           "text":  "│                                           │"
                       },
                       {
                           "index":  69,
                           "style_id":  "",
                           "style":  "",
                           "numbered":  false,
                           "numbering_id":  "",
                           "numbering_level":  "",
                           "text":  "▼                                           ▼"
                       },
                       {
                           "index":  70,
                           "style_id":  "",
                           "style":  "",
                           "numbered":  false,
                           "numbering_id":  "",
                           "numbering_level":  "",
                           "text":  "Switch to Speaker A Cam                  Switch to Wide/Master Cam"
                       },
                       {
                           "index":  71,
                           "style_id":  "",
                           "style":  "",
                           "numbered":  false,
                           "numbering_id":  "",
                           "numbering_level":  "",
                           "text":  "(Hold for 1.5s Minimum)                  (Cross-Talk Event Flag)"
                       },
                       {
                           "index":  73,
                           "style_id":  "",
                           "style":  "",
                           "numbered":  true,
                           "numbering_id":  "3",
                           "numbering_level":  "0",
                           "text":  "Audio Filtering: Apply a 90Hz digital High-Pass Filter to eliminate background bass rumble."
                       },
                       {
                           "index":  74,
                           "style_id":  "",
                           "style":  "",
                           "numbered":  true,
                           "numbering_id":  "3",
                           "numbering_level":  "0",
                           "text":  "Windowing: Slice audio arrays into 100ms intervals."
                       },
                       {
                           "index":  75,
                           "style_id":  "",
                           "style":  "",
                           "numbered":  true,
                           "numbering_id":  "3",
                           "numbering_level":  "0",
                           "text":  "Loudness Calculation: Compute Root Mean Square (RMS) decibels relative to full scale (dBFS)."
                       },
                       {
                           "index":  76,
                           "style_id":  "",
                           "style":  "",
                           "numbered":  true,
                           "numbering_id":  "3",
                           "numbering_level":  "0",
                           "text":  "Switching Rules Engine:"
                       },
                       {
                           "index":  77,
                           "style_id":  "",
                           "style":  "",
                           "numbered":  true,
                           "numbering_id":  "3",
                           "numbering_level":  "1",
                           "text":  "Active Speaker: If Track_A \u003e -45 dBFS AND (Track_A - Track_B) \u003e= 4 dB, flag Cam_A as active."
                       },
                       {
                           "index":  78,
                           "style_id":  "",
                           "style":  "",
                           "numbered":  true,
                           "numbering_id":  "3",
                           "numbering_level":  "1",
                           "text":  "Cross-Talk Event: If Track_A and Track_B are both \u003e -45 dBFS AND abs(Track_A - Track_B) \u003c 2 dB, flag Cam_Wide (Wide/Master Shot) as active."
                       },
                       {
                           "index":  79,
                           "style_id":  "",
                           "style":  "",
                           "numbered":  true,
                           "numbering_id":  "3",
                           "numbering_level":  "1",
                           "text":  "Pacing Hold Protection: Once a camera cut decision is registered, the current camera choice must lock for a minimum of 1.5 seconds (15 windows) to avoid rapid-fire, jarring cuts."
                       },
                       {
                           "index":  81,
                           "style_id":  "Heading3",
                           "style":  "heading 3",
                           "numbered":  false,
                           "numbering_id":  "",
                           "numbering_level":  "",
                           "text":  "Module 5: FCPXML Exporter Layer (With 0.5s Safety Handles)"
                       },
                       {
                           "index":  82,
                           "style_id":  "",
                           "style":  "",
                           "numbered":  true,
                           "numbering_id":  "2",
                           "numbering_level":  "0",
                           "text":  "Format Base: Generate a standard Final Cut Pro XML (v1.8 interchange schema) readable natively by Adobe Premiere Pro."
                       },
                       {
                           "index":  83,
                           "style_id":  "",
                           "style":  "",
                           "numbered":  true,
                           "numbering_id":  "2",
                           "numbering_level":  "0",
                           "text":  "0.5s Safety Handle Calculation: For every calculated edit segment array, manipulate the metadata markers programmatically before compiling the XML string:"
                       },
                       {
                           "index":  84,
                           "style_id":  "",
                           "style":  "",
                           "numbered":  true,
                           "numbering_id":  "2",
                           "numbering_level":  "1",
                           "text":  "xml_start_seconds = calculated_start_seconds - 0.5"
                       },
                       {
                           "index":  85,
                           "style_id":  "",
                           "style":  "",
                           "numbered":  true,
                           "numbering_id":  "2",
                           "numbering_level":  "1",
                           "text":  "xml_duration_seconds = calculated_duration_seconds + 1.0 (accounts for 0.5s padding at both the start and the end)"
                       },
                       {
                           "index":  86,
                           "style_id":  "",
                           "style":  "",
                           "numbered":  true,
                           "numbering_id":  "2",
                           "numbering_level":  "0",
                           "text":  "Lightweight Asset Mapping: Write explicit reference blocks pointing directly to local storage file roots, completely eliminating media re-linking tasks for the human editor."
                       },
                       {
                           "index":  88,
                           "style_id":  "Heading3",
                           "style":  "heading 3",
                           "numbered":  false,
                           "numbering_id":  "",
                           "numbering_level":  "",
                           "text":  "Module 6: Micro-Moments Highlight Analyzer (Phase 2 Focus)"
                       },
                       {
                           "index":  89,
                           "style_id":  "",
                           "style":  "",
                           "numbered":  true,
                           "numbering_id":  "8",
                           "numbering_level":  "0",
